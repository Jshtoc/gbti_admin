# PostgreSQL 접속 정보 (docker-compose의 값과 맞춘다)
POSTGRES_USER=gbti
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gbti
DATABASE_URL=postgres://gbti:change-me@localhost:5432/gbti

# 대시보드 데이터 소스: mock(목데이터) | db(PostgreSQL)
DATA_SOURCE=mock

# 집계 대상 디스코드 서버 ID
DISCORD_GUILD_ID=

# 대시보드 관리자 계정 (Vercel 등 배포 환경의 Environment Variables에 설정)
ADMIN_ID=
ADMIN_PASSWORD=
# (선택) 세션 서명에 섞을 임의 문자열. 바꾸면 모든 로그인 세션이 끊긴다
AUTH_SECRET=
