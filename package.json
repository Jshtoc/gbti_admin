{
  "name": "gbti-admin",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gbti/web",
    "build": "npm run build -w @gbti/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate -w @gbti/db",
    "db:migrate": "npm run migrate -w @gbti/db",
    "bot": "npm run dev -w @gbti/bot"
  }
}
